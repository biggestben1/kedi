    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "build:invoices": "esbuild resources/js/kedi-invoices/main.jsx --bundle --format=iife --outfile=public/js/kedi-invoices.js --jsx=automatic --minify",
